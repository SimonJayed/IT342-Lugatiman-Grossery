<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp">

    <!-- Top Row: Name + Adjustment Pill on Left, Metric Info on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Left Container: Item Name and Quick Adjustment Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/tvMetricProgress"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grocery Item"
                android:textColor="@color/dark_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginEnd="10dp"/>

            <!-- Bidirectional Quick Log Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_rounded_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp">

                <!-- Decrement Button -->
                <TextView
                    android:id="@+id/btnMinus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:alpha="0.4"
                    android:layout_marginHorizontal="6dp"/>

                <!-- Increment Button -->
                <TextView
                    android:id="@+id/btnPlus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Right Label: Actual / Expected -->
        <TextView
            android:id="@+id/tvMetricProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="0.0 / 0.0 units"
            android:textColor="@color/dark_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- Bottom Row: Progress Bar Track -->
    <ProgressBar
        android:id="@+id/pbConsumption"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/background" />

</LinearLayout>
